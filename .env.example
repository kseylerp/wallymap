# Mapbox public token. Unlocks the map itself; without it the map will not load.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Anthropic API key. Unlocks the chat agent when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Which model provider the agent uses: "anthropic" or "openai-compatible".
MODEL_PROVIDER=anthropic
# Model name to use with the chosen provider. Leave blank for the provider default.
MODEL_NAME=
# Base URL of an OpenAI-compatible server. Unlocks local or third-party models (e.g. Ollama).
OPENAI_COMPATIBLE_BASE_URL=
# API key for the OpenAI-compatible server. Unlocks authenticated third-party endpoints.
OPENAI_COMPATIBLE_API_KEY=
# Overpass API endpoint. Unlocks trail, peak, and water queries; defaults to a public instance if blank.
OVERPASS_URL=
# Vercel KV REST URL. Unlocks response caching and rate limiting.
KV_REST_API_URL=
# Vercel KV REST token. Required alongside KV_REST_API_URL.
KV_REST_API_TOKEN=
