# WildMap environment variables. Copy this file to .env.local and fill in what you need.
# Mapbox public token. Unlocks the map itself; without it the map will not load.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Mapbox token for server-side geocoding. Falls back to NEXT_PUBLIC_MAPBOX_TOKEN if blank.
MAPBOX_TOKEN=
# OpenRouter API key. Unlocks the chat agent with the default provider (MODEL_PROVIDER=openrouter).
OPENROUTER_API_KEY=
# Anthropic API key. Unlocks the chat agent when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Which model provider the agent uses: "openrouter", "anthropic", or "openai-compatible".
MODEL_PROVIDER=openrouter
# Model the agent uses (required). Any OpenRouter model slug works, e.g. qwen/qwen3-235b-a22b-2507.
# Default: openai/gpt-oss-120b passed the tool-calling eval at ~1/5 the cost of Claude Haiku.
# Faster but pricier: anthropic/claude-haiku-5.5. Re-test any model with scripts/eval-model.mts.
MODEL_NAME=openai/gpt-oss-120b
# Base URL of an OpenAI-compatible server. Unlocks local or third-party models (e.g. Ollama).
OPENAI_COMPATIBLE_BASE_URL=
# API key for the OpenAI-compatible server. Unlocks authenticated third-party endpoints.
OPENAI_COMPATIBLE_API_KEY=
# Overpass API endpoint for the OpenStreetMap layers (trails, campsites, popularity, remoteness). Recommended, and needed on Vercel in practice:
# the public overpass-api.de refused geometry queries from Vercel (HTTP 406). Use your own server or a keyed endpoint whose URL carries your key
# (keep that URL secret). If blank or failing, the public instance is used.
OVERPASS_URL=
# Vercel KV REST URL. Stores the cache of upstream answers (up to a day) and the rate-limit counters so every serverless instance shares them.
# KV does not limit anything by itself. Without it, each instance keeps its own cache and counters in memory.
KV_REST_API_URL=
# Vercel KV REST token. Required alongside KV_REST_API_URL.
KV_REST_API_TOKEN=
# Chat requests one caller (by IP) may send per 10 minutes. Default 20; 0 turns it off.
RATE_LIMIT_CHAT=
# /api/layer/<id> requests one caller may send per 10 minutes (a shared link makes one per layer). Default 120; 0 turns it off.
RATE_LIMIT_LAYER=
# Chat requests all callers together may send per UTC day. Default 500; 0 turns it off.
RATE_LIMIT_CHAT_DAILY=
# Your own copy of the public-lands vector tiles, as a {z}/{x}/{y}.pbf URL template. Default: the maintainer's paid bucket
# (storage.googleapis.com/wally-tiles); host your own for a public deployment.
PADUS_TILES_URL=
# Mapbox Studio style URL for the Natural Earth 2 basemap; set in Milestone 3.
NEXT_PUBLIC_NATURAL_EARTH_STYLE=
# USGS Water Data API key (free at https://api.waterdata.usgs.gov/signup/). Unlocks a higher rate limit for the stream flow layer; works without one at a low limit.
USGS_API_KEY=
# NASA FIRMS map key (free at https://firms.modaps.eosdis.nasa.gov/api/map_key/). Required for the active fire detections layer; without it that layer reports itself unavailable.
FIRMS_MAP_KEY=
# Mapillary client token (free at https://www.mapillary.com/developer). Optional: adds street-level images to the photo density layer and to popularity scores for views about 15 km across or smaller.
MAPILLARY_TOKEN=
